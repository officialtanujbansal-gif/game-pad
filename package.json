{
  "name": "omnisync-bridge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist-server/server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"for (const p of ['dist','dist-server','release']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "build:renderer": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.mjs",
    "build:desktop": "npm run build:renderer && npm run build:server",
    "dist:windows": "npm run build:desktop && electron-builder --win nsis portable --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "ws": "^8.23.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/express": "^4.17.21",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "electron": "latest",
    "electron-builder": "latest"
  },
  "main": "electron/main.cjs",
  "productName": "OmniSync Bridge",
  "build": {
    "appId": "com.omnisync.bridge",
    "productName": "OmniSync Bridge",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "dist-server/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  }
}
